---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { chapters } from '../../data/chapters';
import { formatLongDate, isPast } from '../../utils/date';
import { withBase } from '../../utils/paths';

/**
 * Structure follows the Figma "Events & Activities - IEEE MIST" frame (node 31:2377):
 * Hero -> Filter & Search bar -> Featured spotlight (bento) -> Main feed grid
 * (with membership callout) -> Load more.
 *
 * Content still comes from the `events` collection so the Decap CMS at /admin
 * keeps working; the Figma cards were static mockups.
 */

const all = (await getCollection('events')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const upcoming = all.filter((e) => !isPast(e.data.date)).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

// Large featured card: the flagged event, else the next upcoming, else the latest.
const featured = all.find((e) => e.data.featured) ?? upcoming[0] ?? all[0];
// Secondary spotlight sits beside it.
const secondary = all.find((e) => e.id !== featured?.id);
const feed = all.filter((e) => e.id !== featured?.id && e.id !== secondary?.id);

const INITIAL = 6;

const filters = [
	{ code: 'all', label: 'All' },
	{ code: 'SB', label: 'Student Branch' },
	...chapters.map((c) => ({ code: c.shortName, label: c.code })),
];

/** "OCTOBER 28, 2024 • MIST CAMPUS" — the eyebrow style used in the design. */
function eyebrow(date: Date, location?: string) {
	const d = formatLongDate(date).toUpperCase();
	return location ? `${d} • ${location.toUpperCase()}` : d;
}
---

<Layout
	title="Events | IEEE MIST Student Branch"
	description="Activities and insights from the IEEE MIST Student Branch — workshops, seminars, symposiums and competitions."
>
	<Header />
	<main>
		<section class="hero">
			<div class="container">
				<h1>Activities &amp; Insights</h1>
				<p>
					Workshops, seminars, symposiums and competitions from the IEEE MIST Student Branch and its
					five technical chapters.
				</p>
			</div>
		</section>

		<section class="filter-bar">
			<div class="container filter-inner">
				<div class="chips" role="group" aria-label="Filter by chapter">
					{
						filters.map((f, i) => (
							<button type="button" class:list={['chip', { active: i === 0 }]} data-filter={f.code}>
								{f.label}
							</button>
						))
					}
				</div>
				<div class="search">
					<img src={withBase('images/home/icon-search.svg')} alt="" />
					<input type="search" placeholder="Search events..." aria-label="Search events" data-search />
				</div>
			</div>
		</section>

		{
			featured && (
				<section class="spotlight">
					<div class="container spotlight-grid">
						<a class="large-card" href={withBase(`/events/${featured.id}`)}>
							<div class="large-media">
								{featured.data.image ? (
									<img src={withBase(featured.data.image)} alt="" />
								) : (
									<div class="ph" />
								)}
							</div>
							<div class="large-body">
								<span class="eyebrow">{eyebrow(featured.data.date, featured.data.location)}</span>
								<h2>{featured.data.title}</h2>
								<p>{featured.data.description}</p>
								<span class="more">Read more →</span>
							</div>
						</a>

						{secondary && (
							<a class="secondary-card" href={withBase(`/events/${secondary.id}`)}>
								<span class="tag">Chapter News</span>
								<h3>{secondary.data.title}</h3>
								<p>{secondary.data.description}</p>
								<span class="eyebrow dark">
									{eyebrow(secondary.data.date, secondary.data.location)}
								</span>
							</a>
						)}
					</div>
				</section>
			)
		}

		<section class="feed">
			<div class="container">
				<div class="feed-grid" data-feed>
					{
						feed.map((event, i) => (
							<article
								class="card"
								data-chapter={event.data.chapter}
								data-title={event.data.title.toLowerCase()}
								data-index={i}
								hidden={i >= INITIAL}
							>
								<a class="card-media" href={withBase(`/events/${event.id}`)}>
									{event.data.image ? (
										<img src={withBase(event.data.image)} alt="" loading="lazy" />
									) : (
										<div class="ph" />
									)}
									<span class="card-chapter">{event.data.chapter}</span>
								</a>
								<div class="card-body">
									<span class="eyebrow dark">{eyebrow(event.data.date, event.data.location)}</span>
									<h3>
										<a href={withBase(`/events/${event.id}`)}>{event.data.title}</a>
									</h3>
									<p>{event.data.description}</p>
								</div>
							</article>
						))
					}

					<article class="callout">
						<h3>Become an IEEE Member</h3>
						<p>
							Unlock technical resources, networking opportunities, and professional development as
							part of the world's largest technical community.
						</p>
						<a class="btn" href={withBase('/contact')}>Join IEEE MIST</a>
					</article>
				</div>

				<p class="no-match" data-no-match hidden>No events match your filter.</p>

				<div class="load-more-wrap">
					<button type="button" class="load-more" data-load-more hidden={feed.length <= INITIAL}>
						Load more
					</button>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	const INITIAL = 6;
	const STEP = 6;

	const cards = [...document.querySelectorAll<HTMLElement>('[data-feed] .card')];
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
	const search = document.querySelector<HTMLInputElement>('[data-search]');
	const loadMore = document.querySelector<HTMLButtonElement>('[data-load-more]');
	const noMatch = document.querySelector<HTMLElement>('[data-no-match]');

	let filter = 'all';
	let query = '';
	let shown = INITIAL;

	function matches(card: HTMLElement) {
		const okChapter = filter === 'all' || card.dataset.chapter === filter;
		const okQuery = !query || (card.dataset.title ?? '').includes(query);
		return okChapter && okQuery;
	}

	function render() {
		let visible = 0;
		cards.forEach((card) => {
			if (!matches(card)) {
				card.hidden = true;
				return;
			}
			visible += 1;
			card.hidden = visible > shown;
		});

		const total = cards.filter(matches).length;
		if (loadMore) loadMore.hidden = shown >= total;
		if (noMatch) noMatch.hidden = total > 0;
	}

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			filter = chip.dataset.filter ?? 'all';
			shown = INITIAL;
			chips.forEach((c) => c.classList.toggle('active', c === chip));
			render();
		});
	});

	search?.addEventListener('input', () => {
		query = search.value.trim().toLowerCase();
		shown = INITIAL;
		render();
	});

	loadMore?.addEventListener('click', () => {
		shown += STEP;
		render();
	});

	render();
</script>

<style>
	.hero {
		background: var(--color-navy);
		padding: 72px 0;
	}

	.hero h1 {
		font-size: 44px;
		font-weight: 700;
		letter-spacing: -0.88px;
		color: #fff;
		margin-bottom: 16px;
	}

	.hero p {
		max-width: 660px;
		font-size: 18px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.8);
	}

	.filter-bar {
		background: #f4f4f4;
		border-bottom: 1px solid var(--color-border);
		padding: 18px 0;
	}

	.filter-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.chip {
		padding: 8px 18px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: #fff;
		font-size: 14px;
		color: var(--color-text-secondary);
	}

	.chip:hover {
		border-color: var(--color-blue);
		color: var(--color-blue);
	}

	.chip.active {
		background: var(--color-navy);
		border-color: var(--color-navy);
		color: #fff;
		font-weight: 600;
	}

	.search {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 9px 16px;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background: #fff;
	}

	.search img {
		width: 14px;
		height: 14px;
		opacity: 0.5;
	}

	.search input {
		width: 200px;
		border: none;
		outline: none;
		font-size: 14px;
		font-family: var(--font-sans);
		color: var(--color-text);
	}

	.eyebrow {
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.75);
	}

	.eyebrow.dark {
		color: var(--color-text-muted);
	}

	.spotlight {
		padding: 56px 0 0;
	}

	.spotlight-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 28px;
		align-items: stretch;
	}

	.large-card {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 426px;
		border-radius: 4px;
		overflow: hidden;
		background: var(--color-navy);
	}

	.large-media {
		position: absolute;
		inset: 0;
	}

	.large-media img,
	.ph {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.ph {
		background: linear-gradient(135deg, var(--color-navy), var(--color-blue));
	}

	.large-card::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(0deg, rgba(0, 40, 85, 0.92) 10%, rgba(0, 40, 85, 0.15) 75%);
	}

	.large-body {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 36px;
	}

	.large-body h2 {
		font-size: 30px;
		font-weight: 700;
		line-height: 1.2;
		color: #fff;
	}

	.large-body p {
		max-width: 560px;
		font-size: 15px;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.85);
	}

	.large-body .more {
		font-size: 14px;
		font-weight: 600;
		color: #fff;
	}

	.secondary-card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 32px;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background: #f4f4f4;
	}

	.secondary-card:hover {
		border-color: var(--color-blue);
	}

	.tag {
		align-self: flex-start;
		padding: 5px 12px;
		border-radius: 999px;
		background: rgba(0, 98, 155, 0.1);
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		color: var(--color-blue);
	}

	.secondary-card h3 {
		font-size: 22px;
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-navy);
	}

	.secondary-card p {
		flex: 1;
		font-size: 15px;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.feed {
		padding: 56px 0 96px;
	}

	.feed-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
		background: #fff;
		transition: box-shadow 0.2s ease;
	}

	.card:hover {
		box-shadow: 0 18px 40px -26px rgba(0, 40, 85, 0.5);
	}

	.card-media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		background: #f4f4f4;
	}

	.card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-chapter {
		position: absolute;
		top: 12px;
		left: 12px;
		padding: 4px 11px;
		border-radius: 999px;
		background: rgba(0, 40, 85, 0.85);
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 1px;
		color: #fff;
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 22px;
		flex: 1;
	}

	.card-body h3 {
		font-size: 18px;
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-navy);
	}

	.card-body p {
		font-size: 14px;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.callout {
		display: flex;
		flex-direction: column;
		gap: 14px;
		justify-content: center;
		padding: 32px;
		border-radius: 4px;
		background: var(--color-navy);
	}

	.callout h3 {
		font-size: 22px;
		font-weight: 700;
		color: #fff;
	}

	.callout p {
		font-size: 14px;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.75);
	}

	.btn {
		align-self: flex-start;
		padding: 13px 26px;
		border-radius: 4px;
		background: var(--color-blue);
		color: #fff;
		font-size: 14px;
		font-weight: 600;
	}

	.no-match {
		margin-top: 32px;
		padding: 48px;
		text-align: center;
		border: 1px dashed var(--color-border);
		border-radius: 4px;
		color: var(--color-text-muted);
	}

	.load-more-wrap {
		display: flex;
		justify-content: center;
		margin-top: 48px;
	}

	.load-more {
		padding: 14px 40px;
		border: 1px solid var(--color-blue);
		border-radius: 4px;
		background: transparent;
		font-size: 15px;
		font-weight: 600;
		color: var(--color-blue);
	}

	.load-more:hover {
		background: var(--color-blue);
		color: #fff;
	}

	@media (max-width: 1024px) {
		.feed-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.spotlight-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.feed-grid {
			grid-template-columns: 1fr;
		}
		.hero h1 {
			font-size: 32px;
		}
		.search input {
			width: 100%;
		}
		.search {
			width: 100%;
		}
	}
</style>
