---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';

const links = [
	{ label: 'Home', href: withBase('/') },
	{ label: 'Chapters', href: withBase('/chapters') },
	{ label: 'Events', href: withBase('/events') },
	{ label: 'About', href: withBase('/about') },
	{ label: 'Contact', href: withBase('/contact') },
	{ label: 'Legacy', href: withBase('/legacy') },
];
---

<Layout title="Page not found | IEEE MIST Student Branch" description="The page you were looking for does not exist.">
	<Header />
	<main class="not-found">
		<div class="container inner">
			<p class="code">404</p>
			<h1>This page could not be found</h1>
			<p class="lede">
				The link may be out of date, or the page may have been moved. Try one of the sections below.
			</p>
			<div class="links">
				{links.map((link) => <a href={link.href}>{link.label}</a>)}
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.not-found {
		display: flex;
		align-items: center;
		min-height: 60vh;
		padding: 96px 0;
		background: var(--color-bg-alt);
	}

	.inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 16px;
	}

	.code {
		font-size: 72px;
		font-weight: 900;
		letter-spacing: -3px;
		color: var(--color-blue);
		line-height: 1;
	}

	h1 {
		font-size: 32px;
		font-weight: 700;
		color: var(--color-navy);
	}

	.lede {
		max-width: 520px;
		font-size: 16px;
		line-height: 1.7;
		color: var(--color-text-secondary);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
		margin-top: 16px;
	}

	.links a {
		padding: 11px 22px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: #fff;
		font-size: 14px;
		font-weight: 600;
		color: var(--color-navy);
	}

	.links a:hover {
		border-color: var(--color-blue);
		color: var(--color-blue);
	}
</style>
