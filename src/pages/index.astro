---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ChapterStory from '../components/ChapterStory.astro';
import LeadershipMessage from '../components/LeadershipMessage.astro';
import SpecializedChapters from '../components/SpecializedChapters.astro';
import ExecutiveCommittee from '../components/ExecutiveCommittee.astro';
import AssociateCommittee from '../components/AssociateCommittee.astro';
import RecentActivities from '../components/RecentActivities.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';
import { getLeadershipMessages } from '../lib/content';

const leadership = await getLeadershipMessages();
const chiefPatron = leadership.chief_patron;
const counselor = leadership.counselor;
---

<Layout>
	<Header />
	<main>
		<Hero />

		<ChapterStory
			accent="#00629b"
			paragraphs={[
				'IEEE MIST Student Branch is the premier technical organization at the Military Institute of Science and Technology, advancing technology for the benefit of humanity.',
				'We are a hub for innovation, leadership, and technical excellence, bringing together five specialized chapters and affinity groups to foster a global community of engineers through workshops, seminars, and hands-on projects.',
			]}
			ctaHref="/about#story"
			ctaLabel="Discover Our Story"
		/>

		<LeadershipMessage
			eyebrow={chiefPatron.eyebrow}
			heading={chiefPatron.heading}
			message={chiefPatron.message}
			personName={chiefPatron.personName}
			personRoles={chiefPatron.personRoles}
			image={chiefPatron.image}
			imageAlt={chiefPatron.imageAlt}
		/>

		<LeadershipMessage
			eyebrow={counselor.eyebrow}
			heading={counselor.heading}
			message={counselor.message}
			personName={counselor.personName}
			personRoles={counselor.personRoles}
			image={counselor.image}
			imageAlt={counselor.imageAlt}
			reverse
		/>

		<SpecializedChapters />
		<ExecutiveCommittee />
		<AssociateCommittee />
		<RecentActivities />
		<Newsletter />
	</main>
	<Footer />
</Layout>
