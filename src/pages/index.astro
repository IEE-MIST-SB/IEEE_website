---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LeadershipMessage from '../components/LeadershipMessage.astro';
import SpecializedChapters from '../components/SpecializedChapters.astro';
import ExecutiveCommittee from '../components/ExecutiveCommittee.astro';
import AssociateCommittee from '../components/AssociateCommittee.astro';
import RecentActivities from '../components/RecentActivities.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />
	<main>
		<Hero />

		<LeadershipMessage
			eyebrow="Leadership Message"
			heading="Chief Patron's Message"
			quote="Our mission is to empower the next generation of engineers with the technical prowess and ethical foundation required to solve global challenges."
			personName="Major General Md. Wahid-Uz-Zaman"
			personTitle="Chief Patron, IEEE MIST"
			image="/images/home/photo-chief-patron.png"
			imageAlt="Major General Md. Wahid-Uz-Zaman"
		/>

		<LeadershipMessage
			eyebrow="Guidance & Vision"
			heading="Branch Counselor's Message"
			quote="Innovation thrives in a community of collaboration. We are committed to providing the resources and mentorship our students need to excel."
			personName="Professor Dr. Murtaza Ali"
			personTitle="Branch Counselor, IEEE MIST"
			image="/images/home/photo-branch-counselor.png"
			imageAlt="Professor Dr. Murtaza Ali"
			reverse
		/>

		<SpecializedChapters />
		<ExecutiveCommittee />
		<AssociateCommittee />
		<RecentActivities />
		<Newsletter />
	</main>
	<Footer />
</Layout>
