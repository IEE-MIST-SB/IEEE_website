---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { legacyPanels } from '../data/committee';
import { withBase } from '../utils/paths';

/**
 * Structure follows the Figma "Legacy - IEEE MIST Student Branch (Refined)" frame
 * (node 31:688): Hero -> year tabs -> executive panel grid.
 */
---

<Layout
	title="Legacy | IEEE MIST Student Branch"
	description="The executive panels that have led the IEEE MIST Student Branch, year by year."
>
	<Header />
	<main>
		<section class="hero">
			<div class="hero-bg"></div>
			<div class="container hero-inner">
				<h1>Branch Legacy</h1>
				<p>
					Every executive panel that has led the IEEE MIST Student Branch. Select a term to see the
					officers who served that year.
				</p>
			</div>
		</section>

		<section class="tabs-section">
			<div class="container">
				<div class="tabs" role="tablist" aria-label="Select a term">
					{
						legacyPanels.map((panel, index) => (
							<button
								type="button"
								role="tab"
								class:list={['tab', { active: index === 0 }]}
								data-year={panel.year}
								aria-selected={index === 0 ? 'true' : 'false'}
							>
								{panel.year}
								{panel.current && <span class="dot" aria-label="Current panel" />}
							</button>
						))
					}
				</div>
			</div>
		</section>

		<section class="panel-display">
			<div class="container">
				{
					legacyPanels.map((panel, index) => (
						<div class="panel" data-panel={panel.year} hidden={index !== 0}>
							<div class="panel-head">
								<h2>
									{panel.year} Executive Panel
									{panel.current && <span class="badge">Current</span>}
								</h2>
								<span class="rule" />
							</div>

							<div class="grid">
								{panel.members.map((member) => (
									<article class="officer">
										<div class="photo">
											{member.avatar ? (
												<img src={member.avatar} alt={member.name} loading="lazy" />
											) : (
												<img
													src={withBase('images/home/icon-person.svg')}
													alt=""
													class="icon"
													loading="lazy"
												/>
											)}
										</div>
										<p class="role">{member.role}</p>
										<p class="name">{member.name}</p>
										{member.department && (
											<p class="dept">
												{member.department}
												{member.major ? ` · ${member.major}` : ''}
											</p>
										)}
									</article>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
	const panels = document.querySelectorAll<HTMLElement>('[data-panel]');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const year = tab.dataset.year;
			tabs.forEach((other) => {
				const on = other === tab;
				other.classList.toggle('active', on);
				other.setAttribute('aria-selected', String(on));
			});
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.panel !== year;
			});
		});
	});
</script>

<style>
	.hero {
		position: relative;
		background: var(--color-navy);
		padding: 96px 0;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 20% 20%, rgba(0, 98, 155, 0.55), transparent 55%),
			radial-gradient(circle at 80% 70%, rgba(112, 32, 130, 0.35), transparent 55%);
	}

	.hero-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.hero h1 {
		font-size: 48px;
		font-weight: 700;
		letter-spacing: -0.96px;
		color: #fff;
	}

	.hero p {
		max-width: 640px;
		font-size: 18px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.8);
	}

	.tabs-section {
		background: #f4f4f4;
		border-bottom: 1px solid var(--color-border);
		padding: 20px 0;
		position: sticky;
		top: 80px;
		z-index: 20;
	}

	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.tab {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 22px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: #fff;
		font-size: 15px;
		font-weight: 600;
		color: var(--color-text-secondary);
		transition: all 0.15s ease;
	}

	.tab:hover {
		border-color: var(--color-blue);
		color: var(--color-blue);
	}

	.tab.active {
		background: var(--color-navy);
		border-color: var(--color-navy);
		color: #fff;
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #4ade80;
	}

	.panel-display {
		padding: 72px 0 96px;
	}

	.panel-head {
		margin-bottom: 48px;
	}

	.panel-head h2 {
		display: flex;
		align-items: center;
		gap: 14px;
		font-size: 32px;
		font-weight: 600;
		color: var(--color-navy);
	}

	.badge {
		padding: 5px 12px;
		border-radius: 999px;
		background: rgba(0, 98, 155, 0.1);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-blue);
	}

	.rule {
		display: block;
		width: 64px;
		height: 4px;
		margin-top: 16px;
		background: var(--color-blue);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.officer {
		padding: 24px;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		text-align: center;
	}

	.photo {
		aspect-ratio: 1;
		margin-bottom: 20px;
		border-radius: 4px;
		overflow: hidden;
		background: #f4f4f4;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.photo img.icon {
		width: 46px;
		height: 46px;
		object-fit: contain;
		opacity: 0.35;
	}

	.officer .role {
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: 8px;
	}

	.officer .name {
		font-size: 16px;
		font-weight: 700;
		color: var(--color-navy);
	}

	.officer .dept {
		margin-top: 6px;
		font-size: 12px;
		color: var(--color-text-muted);
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.hero h1 {
			font-size: 34px;
		}
		.tabs-section {
			position: static;
		}
	}

	@media (max-width: 560px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
