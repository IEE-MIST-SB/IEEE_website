---
import { getCollection } from 'astro:content';
import { formatBadgeDate } from '../utils/date';
import { withBase } from '../utils/paths';

const slides = [
	{
		image: withBase('images/home/event-techfest.png'),
		alt: 'TechFest',
	},
	{
		image: withBase('images/home/event-design-thinking.png'),
		alt: 'Design Thinking workshop',
		tag: 'WORKSHOP',
		title: 'Innovations in Robotics',
		description: 'Bridge the gap between theory and practice with our hands-on robotics automation seminar.',
		date: 'November 05, 2024',
	},
];

/** The three most recent events from the content collection (managed in /admin). */
const events = (await getCollection('events'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3)
	.map((event) => ({
		...formatBadgeDate(event.data.date),
		title: event.data.title,
		description: event.data.description,
		href: withBase(`/events/${event.id}`),
	}));
---

<section class="activities">
	<div class="container">
		<div class="head">
			<h2>Recent Activities</h2>
			<span class="underline"></span>
		</div>

		<div class="layout">
			<div class="slider" data-slider>
				<div class="track" data-track style={`transform: translateX(-100%)`}>
					{
						slides.map((slide) => (
							<div class="slide">
								<img src={slide.image} alt={slide.alt} />
								<div class="gradient" />
								{slide.title && (
									<div class="slide-content">
										<span class="badge">{slide.tag}</span>
										<h3>{slide.title}</h3>
										<p>{slide.description}</p>
										<div class="meta">
											<span class="date">
												<img src={withBase('images/home/icon-calendar.svg')} alt="" />
												{slide.date}
											</span>
											<a href={withBase('/events')} class="btn-register">Register Now</a>
										</div>
									</div>
								)}
							</div>
						))
					}
				</div>

				<button class="nav-btn prev" data-prev aria-label="Previous slide">
					<img src={withBase('images/home/icon-chevron-left.svg')} alt="" />
				</button>
				<button class="nav-btn next" data-next aria-label="Next slide">
					<img src={withBase('images/home/icon-chevron-right.svg')} alt="" />
				</button>

				<div class="dots" data-dots>
					{slides.map((_, i) => <span class:list={['dot', { active: i === 1 }]} data-dot={i} />)}
				</div>
			</div>

			<div class="event-list">
				{
					events.map((event) => (
						<a class="event-card" href={event.href}>
							<div class="date-badge">
								<span class="month">{event.month}</span>
								<span class="day">{event.day}</span>
							</div>
							<div>
								<p class="title">{event.title}</p>
								<p class="desc">{event.description}</p>
							</div>
						</a>
					))
				}
				<a href={withBase('/events')} class="browse-btn">Browse All Past Events</a>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
		const track = slider.querySelector<HTMLElement>('[data-track]');
		const slideCount = slider.querySelectorAll('.slide').length;
		const dots = slider.querySelectorAll<HTMLElement>('[data-dot]');
		let index = 1;

		const render = () => {
			if (!track) return;
			track.style.transform = `translateX(-${index * 100}%)`;
			dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
		};

		slider.querySelector('[data-prev]')?.addEventListener('click', () => {
			index = (index - 1 + slideCount) % slideCount;
			render();
		});
		slider.querySelector('[data-next]')?.addEventListener('click', () => {
			index = (index + 1) % slideCount;
			render();
		});
		dots.forEach((dot, i) =>
			dot.addEventListener('click', () => {
				index = i;
				render();
			})
		);
	});
</script>

<style>
	.activities {
		background: #fff;
		padding: 96px 0;
	}

	.head {
		margin-bottom: 64px;
	}

	.head h2 {
		font-size: 32px;
		font-weight: 600;
		color: var(--color-navy);
		margin-bottom: 16px;
	}

	.underline {
		display: block;
		width: 64px;
		height: 6px;
		border-radius: 12px;
		background: var(--color-blue);
	}

	.layout {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 48px;
		align-items: start;
	}

	.slider {
		position: relative;
		height: 460px;
		border-radius: 16px;
		overflow: hidden;
		background: var(--color-navy);
		border: 1px solid rgba(230, 231, 231, 0.5);
		box-shadow:
			0 10px 15px -3px rgba(0, 0, 0, 0.1),
			0 4px 6px -4px rgba(0, 0, 0, 0.1);
	}

	.track {
		display: flex;
		width: 100%;
		height: 100%;
		transition: transform 0.4s ease;
	}

	.slide {
		position: relative;
		flex: 0 0 100%;
		height: 100%;
	}

	.slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gradient {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			0deg,
			#002855 0%,
			rgba(0, 40, 85, 0.4) 50%,
			rgba(0, 40, 85, 0) 100%
		);
		opacity: 0.95;
	}

	.slide-content {
		position: absolute;
		left: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 40px;
		max-width: 528px;
	}

	.badge {
		display: inline-flex;
		align-self: flex-start;
		padding: 6px 16px;
		background: var(--color-blue);
		border-radius: 4px;
		font-size: 12px;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		color: #fff;
	}

	.slide-content h3 {
		font-size: 32px;
		font-weight: 600;
		color: #fff;
	}

	.slide-content p {
		font-size: 18px;
		color: rgba(255, 255, 255, 0.8);
		line-height: 1.6;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 32px;
		padding-top: 8px;
	}

	.date {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 14px;
		color: #fff;
	}

	.date img {
		width: 18px;
		height: 20px;
	}

	.btn-register {
		background: #fff;
		color: var(--color-navy);
		padding: 12px 32px;
		border-radius: 4px;
		font-size: 16px;
		box-shadow:
			0 20px 25px -5px rgba(0, 0, 0, 0.1),
			0 8px 10px -6px rgba(0, 0, 0, 0.1);
	}

	.nav-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 40px;
		height: 40px;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(6px);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.slider:hover .nav-btn {
		opacity: 1;
	}

	.nav-btn.prev {
		left: 16px;
	}

	.nav-btn.next {
		right: 16px;
	}

	.nav-btn img {
		width: 7.4px;
		height: 12px;
	}

	.dots {
		position: absolute;
		bottom: 24px;
		right: 40px;
		display: flex;
		gap: 8px;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.4);
		cursor: pointer;
		transition:
			width 0.2s ease,
			background 0.2s ease;
	}

	.dot.active {
		width: 24px;
		background: #fff;
	}

	.event-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.event-card {
		display: flex;
		gap: 20px;
		padding: 21px;
		background: #fff;
		border: 1px solid rgba(230, 231, 231, 0.4);
		border-radius: 16px;
	}

	.date-badge {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		border-radius: 8px;
		background: rgba(0, 98, 155, 0.05);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.month {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-blue);
	}

	.day {
		font-size: 24px;
		font-weight: 900;
		color: var(--color-blue);
	}

	.title {
		font-size: 16px;
		color: var(--color-text);
	}

	.desc {
		font-size: 14px;
		color: var(--color-text-secondary);
		padding-top: 4px;
	}

	.browse-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 18px 2px;
		border: 2px dashed rgba(0, 98, 155, 0.2);
		border-radius: 16px;
		color: var(--color-blue);
		font-size: 16px;
	}

	@media (max-width: 900px) {
		.layout {
			grid-template-columns: 1fr;
		}
		.slider {
			height: 380px;
		}
	}
</style>
