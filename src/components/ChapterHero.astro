---
import { withBase } from '../utils/paths';
import { chapterHeroPattern } from '../data/chapterAvatars';
import type { HeroHeadline } from '../data/chapterCopy';

interface Props {
	slug: string;
	code: string;
	fullName: string;
	headline?: HeroHeadline;
	subtitle: string;
	accent: string;
	accent2?: string;
	logo: string;
	exploreLabel?: string;
	eventsLabel?: string;
}

const {
	slug,
	code,
	fullName,
	headline,
	subtitle,
	accent,
	accent2 = accent,
	logo,
	exploreLabel = 'Explore Our Impact',
	eventsLabel = 'Upcoming Events',
} = Astro.props;

const patternExt = chapterHeroPattern[slug];
const pattern = patternExt ? withBase(`images/chapters/${slug}/bg-pattern.${patternExt}`) : null;
---

<section class="chapter-hero" style={`--accent:${accent}; --accent2:${accent2}`}>
	<div class="bg-layer">
		{pattern && <img src={pattern} alt="" class="pattern" />}
	</div>
	<div class="overlay"></div>

	<div class="container content">
		<img src={logo} alt={`${code} logo`} class="logo" />
		<h1>
			{
				headline ? (
					<>
						{headline.before}
						{headline.before && ' '}
						<span class="highlight">{headline.highlight}</span>
						{headline.after && ' '}
						{headline.after}
					</>
				) : (
					fullName
				)
			}
		</h1>
		<p class="subtitle">{subtitle}</p>
		<div class="actions">
			<a href="#about" class="btn btn-primary">{exploreLabel}</a>
			<a href="#events" class="btn btn-outline">{eventsLabel}</a>
		</div>
	</div>
</section>

<style>
	.chapter-hero {
		position: relative;
		display: flex;
		align-items: center;
		height: 600px;
		overflow: hidden;
		background: var(--color-navy);
	}

	.bg-layer {
		position: absolute;
		inset: 0;
	}

	.pattern {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.2;
	}

	.overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--color-navy) 90%, transparent) 0%,
			color-mix(in srgb, var(--accent2) 80%, transparent) 100%
		);
	}

	.content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.logo {
		height: 96px;
		width: auto;
		max-width: 300px;
		object-fit: contain;
		margin-bottom: 16px;
	}

	h1 {
		max-width: 768px;
		font-size: 48px;
		font-weight: 700;
		line-height: 56px;
		letter-spacing: -0.02em;
		color: #fff;
		margin-bottom: 16px;
	}

	.highlight {
		color: var(--accent2);
	}

	.subtitle {
		max-width: 640px;
		font-size: 18px;
		line-height: 28px;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 32px;
	}

	.actions {
		display: flex;
		gap: 16px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 16px 32px;
		border-radius: 4px;
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.01em;
		transition: all 0.25s ease;
	}

	.btn-primary {
		background: var(--accent);
		color: #fff;
	}

	.btn-primary:hover {
		background: var(--accent2);
	}

	.btn-outline {
		border: 1px solid #fff;
		color: #fff;
	}

	.btn-outline:hover {
		background: #fff;
		color: var(--color-navy);
	}

	@media (min-width: 768px) {
		h1 {
			font-size: 64px;
			line-height: 1.1;
		}
	}

	@media (max-width: 640px) {
		.chapter-hero {
			height: auto;
			padding: 64px 0;
		}
		h1 {
			font-size: 34px;
			line-height: 1.2;
		}
		.actions {
			flex-direction: column;
			width: 100%;
		}
	}
</style>
