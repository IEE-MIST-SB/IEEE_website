---
import { withBase } from '../utils/paths';

interface Props {
	paragraphs: string[];
	accent: string;
	image?: string;
	attribution?: string;
	ctaHref?: string;
	ctaLabel?: string;
	/** 'center' (default) matches the home page's centered hero; 'left' matches ChapterHero's left-aligned layout. */
	align?: 'center' | 'left';
}

const { paragraphs, accent, image, attribution, ctaHref, ctaLabel, align = 'center' } = Astro.props;
---

<section class="story" style={`--accent:${accent}`}>
	<div class="container grid" class:list={{ 'no-image': !image, 'align-left': align === 'left' }}>
		{
			image && (
				<div class="photo">
					<img src={withBase(image)} alt="" />
				</div>
			)
		}
		<div class="text">
			<h2>Our Story</h2>
			<span class="underline"></span>
			{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			{attribution && <p class="attribution">— {attribution}</p>}
			{
				ctaHref && (
					<a href={withBase(ctaHref)} class="cta">
						{ctaLabel ?? 'Discover Our Story'} <span aria-hidden="true">→</span>
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.story {
		background: var(--color-bg-alt);
		padding: 32px 0;
	}

	.grid {
		display: grid;
		grid-template-columns: 389px 1fr;
		gap: 48px;
		align-items: center;
	}

	.grid.no-image {
		grid-template-columns: 1fr;
		max-width: 800px;
		margin: 0 auto;
	}

	.photo {
		aspect-ratio: 1 / 1;
		border-radius: 8px;
		overflow: hidden;
		box-shadow:
			0 20px 25px -5px rgba(0, 0, 0, 0.1),
			0 8px 10px -6px rgba(0, 0, 0, 0.1);
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.text h2 {
		font-size: 32px;
		font-weight: 600;
		color: var(--color-navy);
	}

	.underline {
		display: block;
		width: 64px;
		height: 4px;
		margin: 16px 0 24px;
		background: var(--accent);
	}

	.grid.no-image .underline {
		margin-left: auto;
		margin-right: auto;
	}

	.grid.no-image .text {
		text-align: center;
	}

	.grid.no-image.align-left {
		max-width: var(--content-max-width);
	}

	.grid.no-image.align-left .text {
		text-align: left;
		max-width: 760px;
	}

	.grid.no-image.align-left .underline {
		margin-left: 0;
		margin-right: auto;
	}

	.text p {
		font-size: 16px;
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.text p + p {
		margin-top: 16px;
	}

	.attribution {
		margin-top: 20px !important;
		font-size: 14px;
		font-weight: 600;
		font-style: italic;
		color: var(--accent);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 24px;
		font-size: 16px;
		font-weight: 600;
		color: var(--accent);
	}

	.cta span {
		transition: transform 0.2s ease;
	}

	.cta:hover span {
		transform: translateX(4px);
	}

	@media (max-width: 800px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.photo {
			max-width: 320px;
		}
	}
</style>
