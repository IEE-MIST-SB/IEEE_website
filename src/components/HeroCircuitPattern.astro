---
/**
 * Decorative PCB-trace background for dark navy hero sections.
 * Drop this as the first child of a `position: relative; overflow: hidden;` hero,
 * before the content container (which itself needs `position: relative` to paint
 * above this absolutely-positioned pattern).
 *
 * Rendered as a fixed-height band anchored to the hero's bottom edge rather than
 * stretched to fill the hero (`inset: 0`), because hero height varies a lot page
 * to page (short subtitle vs. long copy) — stretching caused `preserveAspectRatio
 *="slice"` to crop unpredictably, sometimes eating into the pattern's own content
 * near the edges. A fixed band means the pattern looks the same on every page.
 */
---

<svg class="bg-pattern" viewBox="0 0 1440 260" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
	<g stroke-linecap="round">
		<path d="M 1480.0 10.1 L 1332.9 10.1 L 1308.4 -3.2 L 1209.4 6.0 L 1184.0 18.2 L 1139.2 18.2" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 30.6 L 1338.4 30.6 L 1255.2 30.6 L 1228.9 22.0 L 1072.9 22.0" fill="none" stroke="rgba(255,255,255,0.27)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 52.1 L 1401.0 52.1" fill="none" stroke="rgba(255,255,255,0.27)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 67.2 L 1408.2 67.2" fill="none" stroke="rgba(255,255,255,0.24)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 88.6 L 1357.7 88.6 L 1327.9 74.3 L 1231.5 74.3 L 1205.3 65.8 L 1174.8 65.8" fill="none" stroke="rgba(255,255,255,0.21)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 112.1 L 1419.9 112.1 L 1392.0 94.7" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="2.5" stroke-linecap="round" />
		<path d="M 1480.0 130.8 L 1382.8 130.8 L 1354.5 138.9 L 1273.3 138.9 L 1246.9 130.1" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 150.1 L 1406.1 150.1" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 172.8 L 1376.6 172.8 L 1346.6 187.3 L 1216.4 187.3 L 1186.7 172.8 L 1100.5 172.8 L 1039.0 172.8" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 191.0 L 1348.8 191.0 L 1327.5 177.4 L 1260.8 177.4 L 1186.3 177.4" fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 212.1 L 1434.9 212.1 L 1407.6 202.5 L 1355.0 202.5 L 1329.1 216.6 L 1183.9 216.6 L 1083.8 216.6" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 231.4 L 1390.3 231.4 L 1309.7 231.4 L 1289.2 216.5 L 1267.7 216.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round" />
		<path d="M 1480.0 248.0 L 1359.2 248.0 L 1225.5 248.0 L 1168.5 248.0 L 1150.9 258.1 L 1064.8 254.0 L 1038.7 268.4 L 924.4 254.0 L 794.6 254.0 L 775.7 264.3 L 714.1 254.0 L 684.5 240.4 L 562.3 240.4" fill="none" stroke="rgba(255,255,255,0.32)" stroke-width="2.5" stroke-linecap="round" />
		<circle cx="1308.4" cy="6.0" r="3" fill="none" stroke="rgba(255,255,255,0.46)" stroke-width="1.4" />
		<circle cx="1184.0" cy="18.2" r="3" fill="rgba(255,255,255,0.42)" />
		<circle cx="1338.4" cy="30.6" r="6.5" fill="rgba(255,255,255,0.55)" />
		<circle cx="1228.9" cy="22.0" r="3" fill="rgba(255,255,255,0.49)" />
		<circle cx="1205.3" cy="65.8" r="3" fill="rgba(255,255,255,0.45)" />
		<circle cx="1100.5" cy="172.8" r="6.5" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" />
		<circle cx="1260.8" cy="177.4" r="6.5" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" />
		<circle cx="1407.6" cy="202.5" r="3" fill="none" stroke="rgba(255,255,255,0.46)" stroke-width="1.4" />
		<circle cx="1329.1" cy="216.6" r="3" fill="none" stroke="rgba(255,255,255,0.41)" stroke-width="1.4" />
		<circle cx="1183.9" cy="216.6" r="3" fill="none" stroke="rgba(255,255,255,0.46)" stroke-width="1.4" />
		<circle cx="1289.2" cy="216.5" r="6.5" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1.4" />
		<circle cx="1150.9" cy="254.0" r="3" fill="none" stroke="rgba(255,255,255,0.53)" stroke-width="1.4" />
		<circle cx="775.7" cy="254.0" r="3" fill="rgba(255,255,255,0.55)" />
		<circle cx="684.5" cy="240.4" r="3" fill="none" stroke="rgba(255,255,255,0.47)" stroke-width="1.4" />

		<!-- left-side chips -->
		<g fill="none" stroke="rgba(255,255,255,0.24)" stroke-width="1.4">
			<path d="M -20 196 L 26 196 L 26 182" />
			<path d="M 26 182 L 64 182 L 64 220 L 26 220 L 26 252 L -20 252" />
			<rect x="26" y="182" width="38" height="38" rx="3" />
			<path d="M 38 182 L 38 170 M 52 182 L 52 170" />
			<path d="M 38 220 L 38 232 M 52 220 L 52 232" />
			<path d="M 64 193 L 78 193 M 64 210 L 78 210" />
		</g>
		<g fill="none" stroke="rgba(255,255,255,0.19)" stroke-width="1.4">
			<path d="M 118 252 L 118 228 L 150 228 L 150 206 L 180 206" />
			<rect x="150" y="206" width="28" height="28" rx="3" />
			<path d="M 160 206 L 160 196 M 170 206 L 170 196" />
			<path d="M 160 234 L 160 244 M 170 234 L 170 244" />
		</g>
		<g fill="rgba(255,255,255,0.4)">
			<circle cx="26" cy="182" r="3" />
			<circle cx="-20" cy="252" r="3" />
			<circle cx="118" cy="252" r="3" />
		</g>
		<g fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.4">
			<circle cx="78" cy="193" r="3" />
			<circle cx="180" cy="206" r="6.5" />
		</g>
	</g>
</svg>

<style>
	.bg-pattern {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: 230px;
	}

	@media (max-width: 640px) {
		.bg-pattern {
			display: none;
		}
	}
</style>
