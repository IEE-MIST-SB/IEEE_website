---
import SectionHeading from './SectionHeading.astro';
import { withBase } from '../utils/paths';
import type { Member } from '../data/committee';

interface Props {
	code: string;
	members: Member[];
	accent: string;
}

const { code, members, accent } = Astro.props;
---

<section class="exec" style={`--accent:${accent}`}>
	<div class="container">
		<SectionHeading title="Executive Committee" description={`Visionaries leading the ${code} Affinity Group at MIST`} />
		<span class="underline"></span>

		<div class="grid">
			{
				members.map((member) => (
					<div class="card">
						<div class="photo">
							{member.avatar ? (
								<img src={member.avatar} alt={member.name} loading="lazy" />
							) : (
								<img src={withBase('images/home/icon-person.svg')} alt="" class="icon" />
							)}
						</div>
						<p class="name">{member.name}</p>
						<p class="role">{member.role}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.exec {
		background: var(--color-bg-alt);
		padding: 32px 0;
	}

	.underline {
		display: block;
		width: 80px;
		height: 4px;
		margin: -36px auto 40px;
		background: var(--accent);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.card {
		text-align: center;
	}

	.photo {
		aspect-ratio: 1 / 1;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
		background: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.card:hover .photo img:not(.icon) {
		transform: scale(1.05);
	}

	.photo img.icon {
		width: 40px;
		height: 40px;
		object-fit: contain;
		opacity: 0.3;
	}

	.name {
		margin-top: 8px;
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
		letter-spacing: 0.01em;
		color: var(--color-text);
	}

	.role {
		font-size: 12px;
		line-height: 16px;
		color: var(--accent);
	}

	@media (min-width: 640px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.grid {
			grid-template-columns: repeat(6, 1fr);
			gap: 16px;
		}
	}
</style>
