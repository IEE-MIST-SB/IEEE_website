---
import { withBase } from '../utils/paths';
import type { Member } from '../data/committee';

interface Props {
	members: Member[];
	accent: string;
}

const { members, accent } = Astro.props;
---

<section class="associate" style={`--accent:${accent}`}>
	<div class="container">
		<div class="head">
			<h2>Associate Committee</h2>
			<span class="rule"></span>
		</div>

		<div class="grid">
			{
				members.map((member) => (
					<div class="card">
						<div class="avatar">
							{member.avatar ? (
								<img src={member.avatar} alt={member.name} loading="lazy" />
							) : (
								<img src={withBase('images/home/icon-person.svg')} alt="" class="icon" />
							)}
						</div>
						<div>
							<p class="name">{member.name}</p>
							<p class="role">{member.role}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.associate {
		background: var(--color-bg-alt);
		padding: 32px 0;
	}

	.head {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 32px;
	}

	.head h2 {
		font-size: 24px;
		font-weight: 600;
		line-height: 32px;
		color: var(--color-navy);
		white-space: nowrap;
	}

	.rule {
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.card {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 16px;
		background: #fff;
		border: 1px solid var(--color-border);
		transition: border-color 0.2s ease;
	}

	.card:hover {
		border-color: var(--accent);
	}

	.avatar {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--color-bg-alt-2);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.avatar img.icon {
		width: 20px;
		height: 20px;
		object-fit: contain;
		opacity: 0.4;
	}

	.name {
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
		letter-spacing: 0.01em;
		color: var(--color-text);
	}

	.role {
		font-size: 12px;
		line-height: 16px;
		color: var(--color-text-secondary);
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
