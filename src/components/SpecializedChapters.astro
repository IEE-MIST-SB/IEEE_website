---
import { withBase } from '../utils/paths';

const chapters = [
	{
		code: 'EDS',
		name: ['ELECTRON', 'DEVICES SOCIETY'],
		logo: withBase('images/home/logo-eds.png'),
		bg: '#e9fdff',
	},
	{
		code: 'APS',
		name: ['ANTENNAS AND', 'PROPAGATION', 'SOCIETY'],
		logo: withBase('images/home/logo-aps.png'),
		bg: 'rgba(102, 123, 255, 0.06)',
	},
	{
		code: 'WIE',
		name: ['WOMEN IN', 'ENGINEERING'],
		logo: withBase('images/home/logo-wie.png'),
		bg: 'rgba(237, 230, 238, 0.4)',
	},
	{
		code: 'MTT-S',
		name: ['MICROWAVE', 'THEORY AND', 'TECHNOLOGY', 'SOCIETY'],
		logo: withBase('images/home/logo-mtts.png'),
		bg: 'rgba(215, 212, 232, 0.4)',
	},
	{
		code: 'SPS',
		name: ['SIGNAL', 'PROCESSING', 'SOCIETY'],
		logo: withBase('images/home/logo-sps.png'),
		bg: 'rgba(202, 234, 211, 0.4)',
	},
];
---

<section class="chapters">
	<div class="container">
		<div class="heading">
			<h2>Our Specialized Chapters</h2>
			<p>Connecting you to the specialized global technical societies of IEEE</p>
		</div>

		<div class="grid">
			{
				chapters.map((chapter) => (
					<div class="card" style={`background:${chapter.bg}`}>
						<div class="logo">
							<img src={chapter.logo} alt={`${chapter.code} logo`} />
						</div>
						<p class="code">{chapter.code}</p>
						<span class="code-underline" aria-hidden="true"></span>
						<p class="name">
							{chapter.name.map((line) => (
								<>
									{line}
									<br />
								</>
							))}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.chapters {
		background: #fff;
		padding: 64px 0;
	}

	.heading {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		text-align: center;
		margin-bottom: 48px;
	}

	.heading h2 {
		font-size: 32px;
		font-weight: 600;
		color: var(--color-navy);
	}

	.heading p {
		max-width: 512px;
		font-size: 16px;
		color: var(--color-text-secondary);
	}

	.grid {
		display: flex;
		flex-wrap: wrap;
		gap: 32px;
		justify-content: center;
	}

	.card {
		width: 217px;
		padding: 41px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 16px;
		backdrop-filter: blur(2px);
		text-align: left;
	}

	.logo {
		height: 80px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 16px;
	}

	.logo img {
		max-height: 80px;
		max-width: 100%;
		object-fit: contain;
	}

	.code {
		font-family: 'Poppins', var(--font-sans);
		font-size: 30px;
		font-weight: 600;
		letter-spacing: 0.5px;
		color: var(--color-navy);
		text-align: center;
		line-height: 1;
	}

	.code-underline {
		display: block;
		width: 28px;
		height: 3px;
		margin: 10px auto 12px;
		border-radius: 2px;
		background: var(--color-blue);
		opacity: 0.45;
	}

	.name {
		font-family: 'Poppins', var(--font-sans);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		text-align: center;
		line-height: 1.5;
	}
</style>
