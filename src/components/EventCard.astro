---
import { formatBadgeDate, formatLongDate } from '../utils/date';
import { withBase } from '../utils/paths';

interface Props {
	title: string;
	date: Date;
	chapter: string;
	description: string;
	image?: string;
	location?: string;
	href: string;
	past?: boolean;
}

const { title, date, chapter, description, image, location, href, past = false } = Astro.props;
const badge = formatBadgeDate(date);
---

<article class:list={['event-card', { past }]}>
	<a href={href} class="media" aria-label={title}>
		{image ? <img src={withBase(image)} alt="" loading="lazy" /> : <div class="placeholder" />}
		<span class="chapter-tag">{chapter}</span>
		<span class="date-badge">
			<span class="month">{badge.month}</span>
			<span class="day">{badge.day}</span>
		</span>
	</a>

	<div class="body">
		<h3><a href={href}>{title}</a></h3>
		<p class="description">{description}</p>
		<div class="meta">
			<span class="date">
				<img src={withBase('images/home/icon-calendar.svg')} alt="" />
				{formatLongDate(date)}
			</span>
			{location && <span class="location">{location}</span>}
		</div>
		<a href={href} class="more">
			{past ? 'View recap' : 'View details'}
			<img src={withBase('images/home/icon-arrow-right.svg')} alt="" />
		</a>
	</div>
</article>

<style>
	.event-card {
		display: flex;
		flex-direction: column;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 16px;
		overflow: hidden;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	.event-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 18px 40px -24px rgba(0, 40, 85, 0.45);
	}

	.media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		background: var(--color-bg-alt);
	}

	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--color-navy), var(--color-blue));
	}

	.chapter-tag {
		position: absolute;
		top: 12px;
		left: 12px;
		padding: 5px 12px;
		border-radius: 999px;
		background: rgba(0, 40, 85, 0.85);
		color: #fff;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1px;
	}

	.date-badge {
		position: absolute;
		bottom: 12px;
		right: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 54px;
		padding: 6px 10px;
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.5);
	}

	.date-badge .month {
		font-size: 10px;
		font-weight: 900;
		letter-spacing: 1px;
		color: var(--color-blue);
	}

	.date-badge .day {
		font-size: 18px;
		font-weight: 800;
		color: var(--color-navy);
		line-height: 1.1;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 20px 22px 24px;
		flex: 1;
	}

	h3 {
		font-size: 19px;
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-navy);
	}

	.description {
		flex: 1;
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
		font-size: 13px;
		color: var(--color-text-muted);
	}

	.meta .date {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.meta img {
		width: 14px;
		height: 14px;
	}

	.more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 4px;
		font-size: 14px;
		font-weight: 600;
		color: var(--color-blue);
	}

	.more img {
		width: 14px;
		height: 14px;
	}

	.event-card.past .media img {
		filter: saturate(0.6);
	}
</style>
