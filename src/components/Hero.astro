---
import { Image } from 'astro:assets';
import heroBg from '../assets/images/hero-bg.png';
---

<section class="hero">
	<Image
		src={heroBg}
		alt=""
		class="hero-bg"
		widths={[640, 1024, 1440, 1920]}
		sizes="100vw"
		quality={70}
		loading="eager"
		fetchpriority="high"
	/>
	<div class="hero-overlay"></div>

	<div class="container hero-content">
		<h1>Empowering Technology for Humanity at MIST</h1>
		<p class="lede">
			IEEE MIST Student Branch is a hub for innovation, leadership, and technical excellence,
			fostering a global community of engineers.
		</p>
		<div class="actions">
			<a href="/about" class="btn btn-primary">
				Explore Hub
				<img src="/images/home/icon-arrow-right.svg" alt="" />
			</a>
			<a href="/about#mission" class="btn btn-glass">Our Mission</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 640px;
		overflow: hidden;
	}

	.hero :global(.hero-bg) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(0deg, rgba(0, 40, 85, 0.72) 0%, rgba(0, 0, 0, 0.32) 100%),
			linear-gradient(90deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.6) 100%);
	}

	.hero-content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 32px;
	}

	.hero-content h1 {
		max-width: 896px;
		font-size: 48px;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.96px;
		color: #fff;
	}

	.lede {
		max-width: 672px;
		font-size: 18px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.9);
	}

	.actions {
		display: flex;
		gap: 16px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 15px 32px;
		border-radius: 4px;
		font-size: 16px;
		font-weight: 400;
	}

	.btn-primary {
		background: var(--color-blue);
		color: #fff;
	}

	.btn-primary img {
		width: 16px;
		height: 16px;
		filter: brightness(0) invert(1);
	}

	.btn-glass {
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(6px);
		border: 1px solid rgba(255, 255, 255, 0.3);
		color: #fff;
	}

	@media (max-width: 640px) {
		.hero-content h1 {
			font-size: 34px;
		}
		.actions {
			flex-direction: column;
			width: 100%;
		}
		.btn {
			justify-content: center;
		}
	}
</style>
