# Supabase project used by the contact form, newsletter, event registration and events.
#
# Both values are optional: when unset, the site falls back to the IEEE MIST project
# baked into src/lib/supabase.ts. The publishable key is safe to expose in the browser —
# what it can do is limited by the Row Level Security policies in supabase/schema.sql.
#
# NEVER put a service_role / secret key or a GitHub token in a PUBLIC_ variable or in this repo.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
